{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": { "fx-audio": ["./src/index.ts"], "fx-audio/*": ["./src/*.ts"] }
  },
  "include": ["src", "test", "test-browser", "examples", "docs/examples", "bench", "*.config.ts"]
}
