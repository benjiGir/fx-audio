{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/node.ts",
    "src/promise.ts",
    "src/react.ts",
    "src/testing.ts"
  ],
  "tsconfig": "tsconfig.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme", "./scripts/typedoc-plugin.mjs"],
  "out": "docs/api",
  "entryFileName": "index",
  "readme": "none",
  "gitRevision": "main",
  "excludeExternals": true,
  "validation": {
    "invalidLink": false
  },
  "docsRoot": "./docs"
}
