{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "test-browser/**",
      "scripts/**",
      "examples/**",
      "*.json",
      "*.ts",
      ".github/**",
      "!.stryker-tmp",
      "!reports"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "semicolons": "asNeeded", "trailingCommas": "none", "quoteStyle": "double" }
  },
  "linter": { "rules": { "preset": "recommended" } }
}
