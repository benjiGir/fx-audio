{
  "name": "fx-audio",
  "version": "0.0.0",
  "description": "Audio library for the browser and Node, built on Effect. Meant to replace Howler.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./promise": {
      "types": "./dist/promise.d.ts",
      "default": "./dist/promise.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage",
    "check:package": "publint && attw --pack . --profile esm-only",
    "test:browser": "vitest run --project \"browser-*\"",
    "mutation": "stryker run",
    "api": "pnpm build && node scripts/api-report.mjs",
    "api:update": "pnpm build && node scripts/api-report.mjs --update",
    "bench:size": "node bench/size.mjs",
    "bench:play": "node bench/play.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "peerDependencies": {
    "effect": "^4.0.4",
    "node-web-audio-api": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "node-web-audio-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@effect/vitest": "4.0.4",
    "@microsoft/api-extractor": "7.59.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/howler": "2.2.13",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "effect": "4.0.4",
    "howler": "2.2.4",
    "node-web-audio-api": "2.2.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  }
}
