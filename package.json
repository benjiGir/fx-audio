{
  "name": "fx-audio",
  "version": "0.0.0",
  "description": "Audio library for the browser and Node, built on Effect. Meant to replace Howler.js.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./promise": {
      "types": "./dist/promise.d.ts",
      "default": "./dist/promise.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project unit --coverage",
    "check:package": "publint && attw --pack . --profile esm-only",
    "test:browser": "vitest run --project browser"
  },
  "peerDependencies": {
    "effect": "^4.0.4",
    "node-web-audio-api": "^2.2.0"
  },
  "peerDependenciesMeta": {
    "node-web-audio-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@effect/vitest": "4.0.4",
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "5.0.4",
    "@vitest/coverage-v8": "5.0.4",
    "effect": "4.0.4",
    "node-web-audio-api": "2.2.0",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "tsdown": "0.23.1",
    "typescript": "^5.9.0",
    "vitest": "5.0.4"
  }
}
