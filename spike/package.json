  "dependencies": {
    "effect": "4.0.4"
  },
  "optionalDependencies": {
    "node-web-audio-api": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "rolldown": "1.2.14",
    "typescript": "^5.9.0"
  }
}
